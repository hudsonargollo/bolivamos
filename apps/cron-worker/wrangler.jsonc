{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "bolivamos-cron-worker",
  "account_id": "cb27e1a67198789eb42d11ab90737652",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Same D1/KV resources as apps/web — created in the ClubeMKT Cloudflare account
  // (cb27e1a67198789eb42d11ab90737652), matching apps/web/wrangler.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bolivamos-db",
      "database_id": "d34573dd-84d2-4a31-be63-b011fbe3bc29"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BOLIVAMOS_KV",
      "id": "0c314347008243f8a51afffc3aa3e404"
    }
  ],
  // UTC expressions — Santa Cruz de la Sierra is UTC-4 (no DST). Convert the
  // intended *local* send time to UTC before relying on these in production.
  "triggers": {
    "crons": [
      "0 13 * * 2", // "The Tuesday Email" weekly digest — Tue 09:00 local
      "0 13 * * 5" // BoliPass Weekend Roundup — Fri 09:00 local
    ]
  }
}
