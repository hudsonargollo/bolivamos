{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bolivamos-web",
  "account_id": "cb27e1a67198789eb42d11ab90737652",
  "main": ".open-next/worker.js",
  // Update to the actual date you first deploy — must be >= 2024-09-23 for @opennextjs/cloudflare.
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Created in the ClubeMKT Cloudflare account (cb27e1a67198789eb42d11ab90737652),
  // so the Worker and the clubemkt.digital DNS zone share one account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bolivamos-db",
      "database_id": "d34573dd-84d2-4a31-be63-b011fbe3bc29",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Created in the ClubeMKT Cloudflare account (cb27e1a67198789eb42d11ab90737652).
  "kv_namespaces": [
    {
      "binding": "BOLIVAMOS_KV",
      "id": "0c314347008243f8a51afffc3aa3e404"
    }
  ],
  // Not secret — safe to keep in source. Secrets (JWT_SECRET, GOOGLE_CLIENT_SECRET,
  // GEMINI_API_KEY, RESEND_API_KEY) are set via `wrangler secret put` and never appear here.
  "vars": {
    "GOOGLE_WEB_CLIENT_ID": "1066105745498-le1a1924cldt7h56rusd2rg8tkf0vbvf.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_ID": "",
    "GOOGLE_ANDROID_CLIENT_ID": ""
  }
}
