{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bolivamos-web",
  "account_id": "193882a3226d5fb9c3611ea50c95992e",
  "main": ".open-next/worker.js",
  // Update to the actual date you first deploy — must be >= 2024-09-23 for @opennextjs/cloudflare.
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Created in the TEKTONE Cloudflare account (193882a3226d5fb9c3611ea50c95992e).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bolivamos-db",
      "database_id": "b817f872-99dc-4382-b881-e6599523381b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Created in the TEKTONE Cloudflare account (193882a3226d5fb9c3611ea50c95992e).
  "kv_namespaces": [
    {
      "binding": "BOLIVAMOS_KV",
      "id": "da883a8e173c4211b5dcf12d62e34ca5",
      "preview_id": "a9222f60f3ba453b976648a3484a12e8"
    }
  ],
  // Not secret — safe to keep in source. Secrets (JWT_SECRET, GOOGLE_CLIENT_SECRET,
  // GEMINI_API_KEY, RESEND_API_KEY) are set via `wrangler secret put` and never appear here.
  "vars": {
    "GOOGLE_WEB_CLIENT_ID": "1066105745498-le1a1924cldt7h56rusd2rg8tkf0vbvf.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_ID": "",
    "GOOGLE_ANDROID_CLIENT_ID": ""
  }
}
