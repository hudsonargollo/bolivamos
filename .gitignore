# dependencies
node_modules/
.pnpm-store/

# env / secrets
.env
.env.local
.env*.local
.dev.vars
.dev.vars.*

# build outputs
.next/
.open-next/
.turbo/
dist/
build/
# ...except vendored third-party assets that happen to ship under a "build/"
# dir in their own package layout (apps/web/public/vendor/three/ — a real,
# committed copy of the three.js browser build, not generated output).
!apps/web/public/vendor/**/build/

# expo / mobile
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# cloudflare
.wrangler/

# imports
imports/brandguide-ui/

# misc
.claude/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo
coverage/
