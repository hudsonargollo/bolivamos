# Copy the relevant vars into each app's local secret file:
#   apps/web/.dev.vars          (wrangler local dev — gitignored)
#   apps/cron-worker/.dev.vars  (wrangler local dev — gitignored)
#   apps/mobile/.env            (Expo public build-time vars — gitignored)
#
# In production these (except EXPO_PUBLIC_*) are set with:
#   pnpm --filter @bolivamos/web exec wrangler secret put <NAME>
#   pnpm --filter @bolivamos/cron-worker exec wrangler secret put <NAME>

# --- apps/web + apps/cron-worker (.dev.vars) ---
JWT_SECRET=dev-only-change-me
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
GEMINI_API_KEY=
DEV_MODE_MOCK_AUTH=true

# --- apps/web wrangler.jsonc `vars` (not secret, but env-specific) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- apps/mobile (.env, EXPO_PUBLIC_* only — never put secrets here) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
